# Copy to deploy/worker.env and fill in. That file is gitignored.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. It belongs
# on a trusted machine and nowhere else — never in the frontend, never in a
# VITE_ variable, never committed.

# Supabase -> Project Settings -> Data API
SUPABASE_URL=https://calgdgaaogsxfdnodlmn.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role  (click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Connect button (or Project Settings -> Database)
#
# Use the SESSION POOLER (aws-0-<region>.pooler.supabase.com, port 5432).
#
# NOT the transaction pooler (6543): transaction mode returns the connection
# after every statement, breaking long transactions and the advisory state
# pgmq relies on.
#
# NOT the direct connection (db.<ref>.supabase.co): it is IPv6-only, and many
# home and cloud networks have no IPv6 route to it.
# Replace [YOUR-PASSWORD]. The scheme is normalised automatically, so paste
# the URI exactly as Supabase gives it if you prefer.
DATABASE_URL=postgresql://postgres.calgdgaaogsxfdnodlmn:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Optional tuning. Raise WORKER_MEMORY if Docker Desktop allows it; keep
# MAX_ANALYSIS_FRAME_MB comfortably below it.
WORKER_MEMORY=4g
MAX_ANALYSIS_FRAME_MB=1200
WORKER_CONCURRENCY=1
