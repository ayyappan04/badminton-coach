# Values for running the stack locally with `docker compose --env-file`.
#
#   docker compose --env-file deploy/local.env \
#     -f docker-compose.yml -f docker-compose.local.yml up --build
#
# NO SECRETS HERE, and none are needed: the local override runs the local
# storage and job backends, so nothing talks to Supabase. These exist only to
# satisfy the base compose file's `:?` guards, which are there so a PRODUCTION
# `docker compose up` cannot start half-configured.
APP_ENV=development
LOG_FORMAT=text
LOG_LEVEL=INFO

STORAGE_BACKEND=local
JOB_BACKEND=local
AUTH_MODE=legacy

DATABASE_URL=sqlite:////data/shuttlesense.db
SUPABASE_URL=http://unused.local
SUPABASE_SERVICE_ROLE_KEY=unused-local-backend
JWT_SECRET=local-compose-secret-not-a-real-credential
CORS_ORIGINS=http://localhost:5173
MAX_VIDEO_GB=5
WORKER_CONCURRENCY=1
