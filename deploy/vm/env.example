# Copy to deploy/vm/.env on the VM and fill in. Never commit the filled copy.

# --- your domain -----------------------------------------------------------
# An A record for this name must already point at the VM's IP, or Caddy cannot
# complete the ACME challenge and will retry in a loop.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# The frontend origin, exactly — scheme, host, no trailing slash.
CORS_ORIGINS=https://badminton-coach-asa24.vercel.app

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://calgdgaaogsxfdnodlmn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SESSION POOLER (port 5432 on the pooler host). Not the transaction pooler
# (6543), which returns the connection after every statement and breaks the
# long transactions and advisory state pgmq relies on. Not the direct
# connection either — it is IPv6-only and many networks cannot reach it.
DATABASE_URL=postgresql://postgres.calgdgaaogsxfdnodlmn:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- tuning ----------------------------------------------------------------
# On a 4 GB VM leave headroom for the OS, Caddy and the API.
WORKER_MEMORY=3g
MAX_ANALYSIS_FRAME_MB=900
WORKER_CONCURRENCY=1

# Required to read /api/v1/metrics in production. Generate with:
#   openssl rand -hex 32
METRICS_TOKEN=
