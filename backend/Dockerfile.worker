# syntax=docker/dockerfile:1.7
# The worker is the same image with a different command and no HTTP port. It is
# defined separately so the two can be scaled, scheduled and resourced
# independently — CV work wants CPU and memory; the API wants neither.
FROM shuttlesense-api:latest

ENV WORKER_CONCURRENCY=1

# No HEALTHCHECK: the worker serves no HTTP. Liveness is the process itself,
# and stalled work is detected by the lease/heartbeat mechanism in the
# database rather than by an HTTP probe.
CMD ["python", "-m", "app.jobs.runner"]
