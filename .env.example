# Copy to backend/.env (or export in your shell) and fill in real values.
# PLACEHOLDERS ONLY — never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production
# production enables HSTS, disables /docs, and REFUSES TO START without a real
# JWT_SECRET below.
APP_ENV=development

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# In development this may be omitted — an ephemeral secret is generated at
# startup (sessions then reset on every restart).
JWT_SECRET=replace-with-openssl-rand-hex-32

# Access-token lifetime in minutes (default 720 = 12h).
JWT_EXPIRE_MINUTES=720

# Comma-separated exact origins. Never use "*" with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only enable behind a proxy you control, otherwise clients can spoof
# X-Forwarded-For and evade rate limits.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Database / storage
# ---------------------------------------------------------------------------
# SQLite for local dev; use PostgreSQL in production.
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://user:PASSWORD@localhost:5432/badminton_coach

# Where uploaded videos and derived assets live. Must NOT be web-served
# directly — all reads go through the authenticated /videos/{id}/stream route.
STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Upload limits and quotas
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_UPLOADS_PER_HOUR=20
MAX_STORAGE_MB_PER_USER=2048
PROCESSING_TIMEOUT_S=900

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console = capture in-process, never send (safe default for dev and CI)
# smtp    = send via the SMTP server configured below
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com

# Used to build verification / reset links in emails.
APP_BASE_URL=http://localhost:5173

# --- Local capture server (recommended for development) --------------------
# MailHog:  docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Mailpit:  docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# then browse the captured mail at http://localhost:8025
# MAIL_BACKEND=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USE_TLS=false

# --- Hosted test inbox (Mailtrap / Ethereal) -------------------------------
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_USE_TLS=true

# --- Production provider ---------------------------------------------------
# Inject these from your secret manager, not from a committed file.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=__FROM_SECRET_MANAGER__
# SMTP_USE_TLS=true

# Require a verified email address before login. Defaults to true when
# APP_ENV=production, false otherwise.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Test-only switches (never set in production)
# ---------------------------------------------------------------------------
# BC_DISABLE_RATE_LIMIT=1
