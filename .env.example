# Copy to backend/.env (or export in your shell) and fill in real values.
# PLACEHOLDERS ONLY — never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production
# production enables HSTS, disables /docs, and REFUSES TO START without a real
# JWT_SECRET below.
APP_ENV=development

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# In development this may be omitted — an ephemeral secret is generated at
# startup (sessions then reset on every restart).
JWT_SECRET=replace-with-openssl-rand-hex-32

# Access-token lifetime in minutes (default 720 = 12h).
JWT_EXPIRE_MINUTES=720

# Comma-separated exact origins. Never use "*" with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only enable behind a proxy you control, otherwise clients can spoof
# X-Forwarded-For and evade rate limits.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Database / storage
# ---------------------------------------------------------------------------
# SQLite for local dev; use PostgreSQL in production.
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://user:PASSWORD@localhost:5432/badminton_coach

# Where uploaded videos and derived assets live. Must NOT be web-served
# directly — all reads go through the authenticated /videos/{id}/stream route.
STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Upload limits and quotas
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_UPLOADS_PER_HOUR=20
MAX_STORAGE_MB_PER_USER=2048
PROCESSING_TIMEOUT_S=900

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console = capture in-process, never send (safe default for dev and CI)
# smtp    = send via the SMTP server configured below
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com

# Used to build verification / reset links in emails.
APP_BASE_URL=http://localhost:5173

# --- Local capture server (recommended for development) --------------------
# MailHog:  docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Mailpit:  docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# then browse the captured mail at http://localhost:8025
# MAIL_BACKEND=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USE_TLS=false

# --- Hosted test inbox (Mailtrap / Ethereal) -------------------------------
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_USE_TLS=true

# --- Production provider ---------------------------------------------------
# Inject these from your secret manager, not from a committed file.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=__FROM_SECRET_MANAGER__
# SMTP_USE_TLS=true

# Require a verified email address before login. Defaults to true when
# APP_ENV=production, false otherwise.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Test-only switches (never set in production)
# ---------------------------------------------------------------------------
# BC_DISABLE_RATE_LIMIT=1

# ===========================================================================
# PRODUCTION ARCHITECTURE (Vercel + Supabase)
# ===========================================================================
# Three tiers, three secret scopes. The boundary is not a convention -- putting
# a value in the wrong column is a real vulnerability:
#
#   FRONTEND (Vercel, VITE_*)  shipped to every browser. Public by definition.
#   API + WORKER containers    hold the privileged secrets.
#   Supabase                   holds identity and the objects.

# ---------------------------------------------------------------------------
# Behaviour switches -- these decide which architecture a process runs.
# ---------------------------------------------------------------------------
# local | supabase
STORAGE_BACKEND=local
# local | pgmq
JOB_BACKEND=local
# legacy | supabase | dual   ("dual" is for the cutover window only)
AUTH_MODE=legacy

# ---------------------------------------------------------------------------
# FRONTEND (Vercel project env). PUBLIC -- assume anyone can read these.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# VITE_API_BASE_URL=https://api.shuttlesense.com

# ---------------------------------------------------------------------------
# API + WORKER containers. PRIVILEGED -- never VITE_*, never in the bundle.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. It belongs
# in the API container, the worker container, and CI secrets -- nowhere else.
# If it ever reaches a browser, every user's footage is readable.
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
#
# Only needed for projects still on a legacy symmetric JWT secret. Preferred
# verification is asymmetric via the project's published JWKS, which needs no
# shared secret in this process at all.
# SUPABASE_JWT_SECRET=<legacy HS256 secret>
# SUPABASE_JWT_AUD=authenticated
#
# Session pooler (port 6543) for serverless/short-lived connections;
# direct (5432) for the worker and for migrations.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Bucket names. Change only if you renamed them in supabase/migrations.
# SUPABASE_BUCKET_ORIGINALS=video-originals
# SUPABASE_BUCKET_DERIVED=video-derived
# SUPABASE_BUCKET_AVATARS=avatars
# SIGNED_URL_TTL_S=3600
# QUEUE_ANALYSIS=shuttlesense_analysis

# ---------------------------------------------------------------------------
# Media limits and profiles
# ---------------------------------------------------------------------------
# MAX_VIDEO_GB=5
# MAX_VIDEO_DURATION_S=5400
#
# ANALYSIS profile: conservative on purpose. Badminton footage is exactly the
# content compression destroys -- a shuttle is a handful of pixels moving very
# fast. Tuning these for file size silently degrades every downstream score.
# MAX_ANALYSIS_WIDTH=1920
# MAX_ANALYSIS_HEIGHT=1080
# MAX_ANALYSIS_FPS_OUT=60
# ANALYSIS_CRF=18
#
# PLAYBACK profile: optimised for browser seeking and egress cost.
# PLAYBACK_MAX_WIDTH=1280
# PLAYBACK_MAX_HEIGHT=720
# PLAYBACK_MAX_FPS=60
# PLAYBACK_CRF=26

# ---------------------------------------------------------------------------
# Worker / queue
# ---------------------------------------------------------------------------
# Scale by adding worker containers, not by raising this.
# WORKER_CONCURRENCY=1
# JOB_LEASE_S=900
# JOB_HEARTBEAT_S=30
# JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Retention and quotas
# ---------------------------------------------------------------------------
# Originals are never deleted as part of processing. Set to false only once a
# deliberate lifecycle policy exists.
# RETAIN_ORIGINAL_ALWAYS=true
# ORIGINAL_RETENTION_DAYS=90
# MAX_ACTIVE_UPLOADS_PER_USER=3
# MAX_ANALYSIS_JOBS_PER_DAY=25
# MAX_STORAGE_MB_PER_USER=2048

# ---------------------------------------------------------------------------
# Storage volume
# ---------------------------------------------------------------------------
# Per-frame pose landmarks are the largest thing this system writes: ~72,000
# rows and ~130 MB of JSON for one 40-minute match. Nothing queries them by
# content, so by default they live in the gzipped analysis artifact instead,
# where the same data is ~76x smaller. Set true only if you have a reason to
# query landmarks relationally.
# PERSIST_POSE_LANDMARKS=false
#
# Bound on the in-process PipelineResult cache. Each entry is tens of MB.
# PIPELINE_CACHE_MAX_ENTRIES=8

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Required in production to read /api/v1/metrics at all.
# METRICS_TOKEN=<random>
